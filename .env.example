# ── FinanceMe — Environment template ───────────────────────────────────────────
# Copy this file to .env and fill in the values before deploying.

# JWT secret — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-secret

# Set to "true" only if the app is served directly over HTTPS without a reverse proxy
HTTPS=false

# Time zone used for payment reminders ("today" / "tomorrow"), e.g. Europe/Madrid
TZ=Europe/Madrid

# Optional: hour (0-23) from which daily push reminders are sent (default 9)
# AVISOS_HORA=9

# Optional: VAPID keys for push notifications (auto-generated and stored in the DB if omitted)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
